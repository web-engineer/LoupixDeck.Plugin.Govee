<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line probe for testing against real lights without LoupixDeck, e.g. over a VPN where
    the lights cannot be seen: every control prints the state before and after. Compiles the
    plugin's Govee layer directly, so it needs nothing from the host.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>govee-probe</AssemblyName>
    <RootNamespace>LoupixDeck.Plugin.Govee.Probe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Govee/**/*.cs" LinkBase="Govee" />
  </ItemGroup>

</Project>
